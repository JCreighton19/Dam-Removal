# Single source of truth for which case study every Slurm job runs.
#
# Every job in this directory sources this file, so this is the only thing
# to edit when switching case studies.
#
# Sample of dams: set the size and seed. The case study name follows from
# them, and run_pipeline.sh generates config/<name>.yaml with
# sample_random_pilot.py if it doesn't exist yet.
#   - PILOT_N_DAMS=all: every dam removal -> case study "all_removals"
#   - PILOT_N_DAMS=<n>: a random sample -> "pilot_random<n>_seed<seed>"
export PILOT_N_DAMS=all
export PILOT_SEED=7
if [[ "$PILOT_N_DAMS" == "all" ]]; then
    export DAM_REMOVAL_CASE_STUDY="all_removals"
else
    export DAM_REMOVAL_CASE_STUDY="pilot_random${PILOT_N_DAMS}_seed${PILOT_SEED}"
fi

# The 50-dam pilot (kept as a benchmark): PILOT_N_DAMS=50, PILOT_SEED=7.
# To run a hand-written config instead, override the name, e.g.:
# export DAM_REMOVAL_CASE_STUDY=pilot_19020401
