# Single source of truth for which case study every Slurm job runs.
#
# Every job in this directory sources this file. To point the whole
# pipeline at a different pilot watershed (or eventually a national
# config), edit this one line -- not each .slurm file's arguments --
# then make sure config/<name>.yaml exists.
export DAM_REMOVAL_CASE_STUDY=pilot_random5_seed42
